[Unit]
Description=private-llm mcp-hub (vision MCP + external MCP proxy)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Environment=LITELLM_BASE=http://127.0.0.1:4000
Environment=PUBLIC_BASE=https://private-llm.onlyservice.io
Environment=MCP_VISION_MODEL=qwen3.6-35b-fp8
EnvironmentFile=/etc/private-llm/mcp-hub.env
ExecStart=/opt/private-llm/venvs/mcp-hub/bin/python /opt/private-llm/mcp-hub/mcp_hub.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
