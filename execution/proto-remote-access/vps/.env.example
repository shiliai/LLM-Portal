# private-llm 网关环境变量（复制为 .env 并填实值；.env 不入库）
# LiteLLM master key：仅管理用途（r6 起公网不再有接受 master key 的端点；控制台登录/管理 API 回环/onboardd）
# 生成：openssl rand -hex 16 后加 sk- 前缀（LiteLLM 要求 master key 以 sk- 开头）
LITELLM_MASTER_KEY=sk-REPLACE_ME

# Postgres 密码（生成：openssl rand -hex 16）
POSTGRES_PASSWORD=REPLACE_ME

# 域名（证书与 nginx 站点）
DOMAIN=llm-portal.example.com

# 对外入口模式：standalone（默认）= 本栈 edge-nginx/edge-certbot 发布 80/443，零既有依赖；
# external = 复用既有 nginx 容器（需下面三个变量，网络名自动探测）；
# offload = TLS 由上游设备（防火墙反代等）终结，本栈仅 HTTP-only edge-nginx 监听 80，
#           上游反代回源 http://<本机>:80。对上游反代的要求：SSE 关响应缓冲、
#           读超时≥3600s、透传 X-Forwarded-Proto: https（edge-nginx 将其透传下游）
EDGE_MODE=standalone

# 对外完整基地址（默认 https://<DOMAIN>）。offload 模式外部 URL 通常带高位端口，
# 须显式设置（mcp-hub 对外端点、onboardd 站点接入命令用），例：https://llm.example.com:8080
# PUBLIC_BASE=https://llm.example.com:8080
# 站点 wg Endpoint 主机（默认 <DOMAIN>）。offload 内网部署时站点直连网关内网 IP，
# 不经上游反代（其不转发 UDP），例：192.168.88.22
# WG_ENDPOINT_HOST=192.168.88.22

# ---- 仅 EDGE_MODE=external 需要 ----
# 既有 nginx 容器名：deploy.sh 探测其网络、注入 server 块并 reload
# EDGE_NGINX_CONTAINER=your-nginx
# 既有 nginx 配置目录（nginx.conf 所在，须与容器内 bind-mount 对应）
# NGINX_CONF_DIR=/home/YOURUSER/docker/nginx
# 既有 certbot webroot/letsencrypt 目录（conf/ 与 www/ 子目录）
# CERTBOT_DIR=/home/YOURUSER/docker/certbot

# 入口共享网络（standalone 默认 private-llm-edge，deploy.sh 自动创建；external 自动探测）
NGINX_SHARED_NETWORK=private-llm-edge

# onboardd 管理 token（site-add/site-revoke/site-list 与 consoled 调 admin API 用；生成：openssl rand -hex 24）
ONBOARD_ADMIN_TOKEN=REPLACE_ME

# WireGuard
WG_PORT=51820
# 站点隧道网段。默认 10.77.0.0/24；若站点机器还要同时连另一套 10.77.0.0/24 网关
# （双隧道并存，如内网新实例+既有 VPS 实例），此处换独立网段（如 10.78.0.0/24），
# 并同步改 WG_VPS_IP（如 10.78.0.1）。注意：换网段=重建网关 wg0（站点须重新注册）
WG_SUBNET=10.77.0.0/24
WG_VPS_IP=10.77.0.1

# mcp-hub：视觉模型（经 LiteLLM 回调，记调用者 Key 的账）
MCP_VISION_MODEL=qwen3.6-35b-fp8

# consoled：监听端口（默认 8300，仅 docker 网段/本机可达；无需改）
# CONSOLE_PORT=8300

# 管理控制台管理员登录（/console/admin-login.html，邮箱 + 密码 + 可选 2FA）。
# 配置 ADMIN_EMAIL 后 master key 不再作为网页登录方式；轮换凭据 = 改这里重跑 deploy.sh
# （示例值留空；部署时填管理员真实邮箱）
ADMIN_EMAIL=
# 初始密码（生成：openssl rand -base64 18）
ADMIN_PASSWORD=REPLACE_ME
# 2FA（TOTP，可选；留空=不启用）。生成 base32 密钥：
#   python3 -c "import secrets,base64;print(base64.b32encode(secrets.token_bytes(20)).decode())"
# 在手机认证器（Google Authenticator / 1Password 等）手动录入该密钥（SHA1 / 6 位 / 30 秒）
ADMIN_TOTP_SECRET=
