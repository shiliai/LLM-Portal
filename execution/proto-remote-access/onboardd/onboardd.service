[Unit]
Description=private-llm onboardd (site registration: wg peers + litellm deployments)
After=network-online.target docker.service wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Environment=LITELLM_BASE=http://127.0.0.1:4000
EnvironmentFile=/etc/private-llm/onboardd.env
ExecStart=/opt/private-llm/venvs/onboardd/bin/python /opt/private-llm/onboardd/onboardd.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
