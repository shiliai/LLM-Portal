[Unit]
Description=private-llm console (管理控制台后端, 设计 §3.6, US-P14)
After=network-online.target docker.service mcp-hub.service onboardd.service
Wants=network-online.target

[Service]
User=root
# wg show / usage.db / systemctl restart mcp-hub 需要 root；仅 docker 网段与本机可达（ufw 拦公网）
Environment=LITELLM_BASE=http://127.0.0.1:4000
Environment=ONBOARDD_URL=http://127.0.0.1:8100
Environment=MCP_HUB_URL=http://127.0.0.1:8200
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/private-llm/console.env
ExecStart=/opt/private-llm/venvs/console/bin/python /opt/private-llm/console/console.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
