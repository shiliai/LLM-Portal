# private-llm 全链路分段可观测性（issue #62）——Prometheus 拉取配置模板
# 由 ../scripts/render-prometheus-config.sh 显式渲染为 prometheus.yml。
# Prometheus 不展开 shell 环境变量；渲染确保实例标签和每个 blackbox target 都是确定的。
# 低基数：标签仅 instance/container/model/group/site/deployment/proto/stream/status，
#         绝不带 request_id/调用方/正文/完整 IP。（D7）

global:
  scrape_interval: 15s      # 常规指标
  evaluation_interval: 30s  # 规则求值
  external_labels:
    portal_instance: "__OBSERVABILITY_INSTANCE__"

# 告警规则（记录 + 告警；通知通道见 README D1 后续 / RUNBOOK）
rule_files:
  - /etc/prometheus/rules.yml

scrape_configs:
  # 自定义回调指标（TTFT/生成/错误/token + request_id 结构化日志）:48400。
  # 原生 LiteLLM /metrics 在生产要求鉴权；本配置绝不保存管理凭据。
  - job_name: litellm-observability
    metrics_path: /metrics
    scrape_interval: 15s
    static_configs:
      - targets: ["127.0.0.1:48400"]

  # compat 协议层（parse / upstream_header / active / errors）
  - job_name: compat
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:8400"]

  # Postgres 连接数（postgres-exporter，仅回环发布）
  - job_name: postgres
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9187"]
    metric_relabel_configs:
      # 低基数：只保留数据库连接数/后台相关，避免表级高基数
      - source_labels: [__name__]
        regex: '^(pg_stat_database_numbackends|pg_up|pg_stat_activity_connection_count|pg_settings_max_connections)$'
        action: keep

  # 实例 OS（node-exporter host 网络，服务自身绑定回环）
  - job_name: node
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9100"]

  # 容器层（cadvisor；仅保留有界服务名，去除 ID/image/任意 compose label）
  - job_name: cadvisor
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:8080"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: '^(container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_memory_rss|container_start_time_seconds|container_oom_events_total|container_network_receive_bytes_total|container_network_transmit_bytes_total)$'
        action: keep
      - regex: '^(id|image|name|container)$'
        action: labeldrop
      - source_labels: [container_label_com_docker_compose_service]
        regex: '(.+)'
        target_label: container
        replacement: '$1'
        action: replace
      - regex: '^container_label_.*$'
        action: labeldrop

  # WireGuard 站点链路：blackbox HTTP 探针（60s 低频，不扰动模型服务）（D5）
  - job_name: blackbox-sites
    metrics_path: /probe
    scrape_interval: 60s
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          __BLACKBOX_TARGETS__
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # Prometheus 自身
  - job_name: prometheus
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9090"]
