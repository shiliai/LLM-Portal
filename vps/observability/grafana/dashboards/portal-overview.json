{
  "__inputs": [],
  "title": "Portal 全链路分段指标",
  "uid": "portal-overview",
  "version": 1,
  "tags": [
    "private-llm",
    "observability"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求量（req/s）",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(litellm_requests_total[$__rate_interval])) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "活跃请求",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(litellm_active_requests) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "请求成功率（1h）",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(sum(increase(litellm_requests_total[1h])) - sum(increase(litellm_errors_total[1h])), 0) / clamp_min(sum(increase(litellm_requests_total[1h])), 1)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TTFT P50/P95/P99（s）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(litellm_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(litellm_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(litellm_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "总耗时 & 分段（P95，s）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(litellm_total_seconds_bucket[5m])) by (le))",
          "legendFormat": "LL total P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(compat_upstream_header_seconds_bucket[5m])) by (le,proto))",
          "legendFormat": "compat->LL头 {{proto}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(compat_parse_seconds_bucket[5m])) by (le))",
          "legendFormat": "compat parse P95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "生成阶段 P95（s；推导 total-ttft）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(litellm_generation_seconds_bucket[5m])) by (le))",
          "legendFormat": "generation P95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "错误率（按状态类别）",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(litellm_errors_total[5m])) / clamp_min(sum(rate(litellm_requests_total[5m])), 1e-9)",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Postgres 连接数",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=\"litellm\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "容器 CPU（核）",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[$__rate_interval])) by (container)",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "容器 RSS（GiB）",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_rss{container!=\"\"}) / 1073741824",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "站点可达性（probe_success）",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-sites\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "站点 HTTP RTT（s）",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_duration_seconds{job=\"blackbox-sites\"}",
          "legendFormat": "{{instance}} {{phase}}"
        }
      ]
    }
  ]
}
