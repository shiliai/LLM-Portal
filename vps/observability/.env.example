# private-llm 观测栈环境变量（复制为 .env 并填实值；.env 不入库）
# POSTGRES_PASSWORD 从 private-llm 部署环境复用；其余仅属于观测栈。

# private-llm 核心 compose 的后端网络，供 postgres-exporter 连接数据库。
PRIVATE_LLM_BACKEND_NETWORK=private-llm_default

# postgres 只读连接（favor least privilege：建专用只读角色，见 RUNBOOK.md §数据保留）
POSTGRES_PASSWORD=REPLACE_ME
# 连接用户名（默认 litellm；建议单独只读账号）
# PG_EXPORTER_USER=prometheus_ro

# Prometheus 保留（时间 / 容量上限，达到任一即滚动淘汰）
PROM_RETENTION=14d
PROM_RETENTION_SIZE=10GB

# Grafana 管理员初始密码（安装后立即改）
GF_ADMIN_PASSWORD=REPLACE_ME

# Prometheus external label（每台机器唯一，例如 vps / nas；由渲染脚本读取，不由 Prometheus 展开）
OBSERVABILITY_INSTANCE=vps

# blackbox：逗号分隔的 SITE=http(s)://...；SITE 是稳定、低基数标签。
SITE_TARGETS=site-a=http://10.77.0.11:8890/health
