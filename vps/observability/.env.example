# private-llm 观测栈环境变量（复制为 .env 并填实值；.env 不入库）
# 与 vps/.env 同源：NGINX_SHARED_NETWORK、POSTGRES_PASSWORD 从 private-llm 部署环境复用

# private-llm compose 所在 docker 网络名（探测方法同 vps: docker inspect nginx-sub2api）
NGINX_SHARED_NETWORK=docker_default

# postgres 只读连接（favor least privilege：建专用只读角色，见 RUNBOOK.md §数据保留）
POSTGRES_PASSWORD=REPLACE_ME
# 连接用户名（默认 litellm；建议单独只读账号）
# PG_EXPORTER_USER=prometheus_ro

# Prometheus 保留（时间 / 容量上限，达到任一即滚动淘汰）
PROM_RETENTION=14d
PROM_RETENTION_SIZE=10GB

# Grafana 管理员初始密码（安装后立即改）
GF_ADMIN_PASSWORD=REPLACE_ME

# blackbox：WireGuard 站点 health 目标（见 RUNBOOK.md）：逗号分隔 http://10.77.0.x:PORT/health
SITE_TARGETS=http://10.77.0.11:8890/health
